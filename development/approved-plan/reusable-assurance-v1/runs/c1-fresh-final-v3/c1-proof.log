         n
         m
         rp
         wp
         xp
         ordinary
         (s,a)
         ==> assurance_checked_run 3
             (c1_crypto_ready lib_file stackpointer p q n m rp xp ordinary s
             a)
             (c1_segment_policy stackpointer p q n rp wp xp ordinary)
             s
