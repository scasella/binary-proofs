val c1_crypto_slot_region_disjoint_statement : term =
  `forall stackpointer.
       16 <= val stackpointer /\
       val stackpointer + 8 < 2 EXP 64 /\
       nonoverlapping (word_sub stackpointer (word 16),8) (word 270800960,95)
       ==> (forall addr.
                ~(assurance_region (word 270800960) 95 addr /\
                  assurance_region (word_sub stackpointer (word 16)) 8 addr))`
- : unit = ()
