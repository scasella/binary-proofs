val e5_normal_flags : thm =
  |- forall s.
         e5_normal_flags s <=>
         ~bit 16 (read rflags s) /\ ~bit 8 (read rflags s)
val e5_rf_clear : thm =
  |- forall s. e5_rf_clear s = write (rflags :> bitelement 16) false s
val e5_rf_retired_step : thm =
  |- forall s t.
         e5_rf_retired_step s t <=> (exists u. x86 s u /\ t = e5_rf_clear u)
val e5_rf_retired_extended_step : thm =
  |- forall s a t.
         e5_rf_retired_extended_step (s,a) t <=>
         (exists u b.
              abi_caller_scalar_extended_step (s,a) (u,b) /\
              t = e5_rf_clear u,b)
val e5_normal_step_policy : thm =
  |- forall C k s t.
         e5_normal_step_policy C k s t <=>
         C k s t /\ e5_normal_flags s /\ e5_normal_flags t
val e5_normal_environment : thm =
  |- forall long_mode cpl dr7 cet_enabled external_event_delivered debug_agent_modified.
         e5_normal_environment long_mode cpl dr7 cet_enabled
         external_event_delivered
         debug_agent_modified <=>
         long_mode /\
         cpl = 3 /\
         (forall i. i < 8 ==> ~bit i dr7) /\
         ~cet_enabled /\
         ~external_event_delivered /\
         ~debug_agent_modified
val e5_rf_checked_run : thm =
  |- (e5_rf_checked_run 0 P C s <=> P s) /\
     (e5_rf_checked_run (SUC n) P C s <=>
      (exists t. e5_rf_retired_step s t) /\
      (forall t.
           e5_rf_retired_step s t
           ==> C (SUC n) s t /\ e5_rf_checked_run n P C t))
- : unit = ()
val e5_rf_clear_identity_statement : term =
  `forall s. ~bit 16 (read rflags s) ==> e5_rf_clear s = s`
val e5_scalar_operation_outside_flags_statement : term =
  `forall inst s t k.
       k < 64 /\
       ~MEM k [0; 2; 4; 6; 7; 11] /\
       abi_caller_scalar_instruction inst /\
       x86_execute inst s t
       ==> (bit k (read rflags t) <=> bit k (read rflags s))`
val e5_qualified_step_outside_flags_statement : term =
  `forall s t k.
       k < 64 /\
       ~MEM k [0; 2; 4; 6; 7; 11] /\
       abi_all_decodes_caller_scalar s /\
       x86 s t
       ==> (bit k (read rflags t) <=> bit k (read rflags s))`
val e5_qualified_step_normal_statement : term =
  `forall s t.
       e5_normal_flags s /\ abi_all_decodes_caller_scalar s /\ x86 s t
       ==> e5_normal_flags t`
val e5_rf_retired_step_normal_eq_statement : term =
  `forall s t.
       e5_normal_flags s /\ abi_all_decodes_caller_scalar s
       ==> (e5_rf_retired_step s t <=> x86 s t)`
val e5_rf_retired_extended_normal_eq_statement : term =
  `forall s t a b.
       e5_normal_flags s /\ abi_all_decodes_caller_scalar s
       ==> (e5_rf_retired_extended_step (s,a) (t,b) <=>
            abi_caller_scalar_extended_step (s,a) (t,b))`
val e5_checked_run_normal_statement : term =
  `forall n P C s.
       (forall k source target.
            C k source target ==> abi_all_decodes_caller_scalar source) /\
       assurance_checked_run n P C s /\
       e5_normal_flags s
       ==> assurance_checked_run n (\t. P t /\ e5_normal_flags t)
           (e5_normal_step_policy C)
           s`
val e5_rf_checked_run_normal_statement : term =
  `forall n P C s.
       (forall k source target.
            C k source target ==> abi_all_decodes_caller_scalar source) /\
       assurance_checked_run n P C s /\
       e5_normal_flags s
       ==> e5_rf_checked_run n (\t. P t /\ e5_normal_flags t)
           (e5_normal_step_policy C)
           s`
val e5_normal_checked_run_extended_lift_statement : term =
  `forall n P C s a.
       (forall k source target.
            C k source target ==> abi_all_decodes_caller_scalar source) /\
       assurance_checked_run n P C s /\
       e5_normal_flags s
       ==> eventually_n e5_rf_retired_extended_step n
           (\t.
                P (FST t) /\
                e5_normal_flags (FST t) /\
                SND t = a /\
                abi_required_controls_preserved a (SND t))
           (s,a)`
- : unit = ()
