val CLIENT_CHECKED_RUN_STEP : thm =
  |- forall n P C s.
         assurance_checked_run (1 + n) P C s <=>
         (exists s'. x86 s s') /\
         (forall s'.
              x86 s s' ==> C (1 + n) s s' /\ assurance_checked_run n P C s')
