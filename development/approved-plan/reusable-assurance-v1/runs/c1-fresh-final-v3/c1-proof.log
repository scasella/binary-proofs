val ra_checked_run_append_statement : term =
  `forall m n P C s.
       assurance_checked_run m (\t. assurance_checked_run n P C t)
       (\k source target. C (n + k) source target)
       s
       ==> assurance_checked_run (m + n) P C s`
val ra_checked_run_post_mono_statement : term =
  `forall n P Q C s.
       (forall t. P t ==> Q t) /\ assurance_checked_run n P C s
       ==> assurance_checked_run n Q C s`
val ra_checked_run_policy_mono_statement : term =
  `forall n P C D s.
       (forall k source target. C k source target ==> D k source target) /\
       assurance_checked_run n P C s
       ==> assurance_checked_run n P D s`
- : unit = ()
