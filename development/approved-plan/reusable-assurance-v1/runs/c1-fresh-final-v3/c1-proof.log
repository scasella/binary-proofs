val bp_reuse_decoded_step_statement : term =
  `forall len inst s.
       x86_decode s (read RIP s) (len,inst)
       ==> x86 s =
           (RIP := word_add (read RIP s) (word len) ,, x86_execute inst) s`
val bp_reuse_riprel_jump_successor_statement : term =
  `forall pc disp target e m s.
       x86_decode s pc (6,JUMP Unconditional (Memop Quadword (Riprel disp))) /\
       read RIP s = pc /\
       read memory s = m /\
       read events s = e /\
       read (memory :> bytes64 (word_add (word_add pc (word 6)) disp)) s =
       target
       ==> (exists next. x86 s next) /\
           (forall next.
                x86 s next
                ==> read RIP next = target /\
                    read memory next = m /\
                    read events next =
                    APPEND
                    [EventJump (word_add pc (word 6),target);
                     EventLoad (word_add (word_add pc (word 6)) disp,8)]
                    e /\
                    (MAYCHANGE [RIP] ,, MAYCHANGE [events]) s next)`
val bp_reuse_riprel_jump_checked_hop_statement : term =
  `forall pc disp target e m rp xp s.
       x86_decode s pc (6,JUMP Unconditional (Memop Quadword (Riprel disp))) /\
       read RIP s = pc /\
       read memory s = m /\
       read events s = e /\
       read (memory :> bytes64 (word_add (word_add pc (word 6)) disp)) s =
       target /\
       assurance_span_ok xp (val pc) 6 /\
       assurance_span_ok rp (val (word_add (word_add pc (word 6)) disp)) 8
       ==> assurance_checked_run 1
           (\next.
                read RIP next = target /\
                read memory next = m /\
                read events next =
                APPEND
                [EventJump (word_add pc (word 6),target);
                 EventLoad (word_add (word_add pc (word 6)) disp,8)]
                e /\
                (MAYCHANGE [RIP] ,, MAYCHANGE [events]) s next)
           (\remaining source successor.
                assurance_step_policy rp (\a. false) xp source successor /\
                x86_decode source (read RIP source)
                (6,JUMP Unconditional (Memop Quadword (Riprel disp))) /\
                read RIP successor = target /\
                read memory successor = read memory source /\
                (MAYCHANGE [RIP] ,, MAYCHANGE [events]) source successor)
           s`
val bp_reuse_riprel_jump_omitted_statement : term =
  `forall pc disp s a next a'.
       x86_decode s pc (6,JUMP Unconditional (Memop Quadword (Riprel disp))) /\
       read RIP s = pc /\
       abi_caller_scalar_extended_step (s,a) (next,a')
       ==> a' = a`
val bp_c1_plt_decode_statement : term =
