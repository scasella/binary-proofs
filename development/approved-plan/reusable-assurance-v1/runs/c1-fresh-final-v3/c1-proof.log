val cw_external : thm =
  |- forall a. cw_external a <=> 1342177280 <= a /\ assurance_canonical48 a
val cw_layout : thm =
  |- forall different n q p k.
         cw_layout p q n k different <=>
         n < 2 EXP 64 /\
         assurance_span_ok cw_external (val p) n /\
         assurance_span_ok cw_external (val q) n /\
         (different
          ==> k < n /\
              (forall i.
                   i < n ==> ~(word_add q (word i) = word_add p (word k))))
val cw_seed : thm =
  |- forall lib_file client_file different addr p k.
         cw_seed lib_file client_file p k different addr =
         (if fb_immutable (val addr)
          then lib_file (val addr - 268435456)
          else if c1_immutable (val addr)
               then client_file (val addr - 553648128)
               else if different /\ addr = word_add p (word k)
                    then word 255
                    else word 128)
val cw_memory : thm =
  |- forall lib_file client_file p k different.
         cw_memory lib_file client_file p k different =
         write (bytes64 (word 3145736)) (word 4194304)
         (write (bytes64 (word 553664472)) (word 270800960)
         (cw_seed lib_file client_file p k different))
val cw_state : thm =
  |- forall q n lib_file client_file p k different.
         cw_state lib_file client_file p q n k different =
         x86state_RECORD (word 553652496)
         (\j.
              if j = word 7
              then p
              else if j = word 6
                   then q
                   else if j = word 2
                        then word n
                        else if j = word 4 then word 3145736 else word 0)
         (\j. word 0)
         (\j. word 0)
         (word 2)
         (cw_memory lib_file client_file p k different)
         []
val cw_read : thm =
  |- forall a. cw_read a <=> assurance_canonical48 a /\ ~(a = 0)
val cw_write : thm =
  |- forall a.
         cw_write a <=>
         (if lw_image_domain a
          then lw_image_write a
          else if c1_image_domain a
               then c1_image_write a
               else assurance_canonical48 a)
val cw_execute : thm =
  |- forall a. cw_execute a <=> lw_execute a \/ c1_image_execute a
val cw_ordinary : thm =
  |- forall a. cw_ordinary a <=> assurance_canonical48 a
val c1_entry_witness : thm =
  |- forall lib_file client_file different k p q n.
         c1_entry_witness lib_file client_file p q n k different <=>
         (exists lib_rw lib_padding client_rw client_padding m rp wp xp ordinary s a.
              c1_pre lib_file lib_rw lib_padding client_file client_rw
              client_padding
              (word 3145736)
              (word 4194304)
              p
              q
              n
              m
              rp
              wp
              xp
              ordinary
              (s,a) /\
              (forall i.
                   i < n
                   ==> m (word_add p (word i)) =
                       (if different /\ i = k then word 255 else word 128)) /\
              (forall i. i < n ==> m (word_add q (word i)) = word 128) /\
              (p = word 0 /\ q = word 0 /\ n = 0 ==> ~rp 0))
